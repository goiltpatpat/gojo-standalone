# Optional OpenAI API Key for AI Summarization
OPENAI_API_KEY=

# Model to use for summarization (e.g. gpt-4o-mini, gpt-4o, gpt-5.4-mini)
GOJO_HN_MODEL=gpt-4o-mini

# Database path for local SQLite storage (defaults to gojo_hn.db in working dir)
GOJO_HN_DB_PATH=gojo_hn.db

# Enable or disable Jina reader fallback (true/false)
GOJO_HN_JINA_FALLBACK=true
